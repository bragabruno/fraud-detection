# Test environment specific configurations

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:h2:mem:frauddb-test
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=password
SPRING_JPA_HIBERNATE_DDL_AUTO=create
SPRING_JPA_SHOW_SQL=true

# Plaid API Configuration
PLAID_CLIENT_ID=test_client_id
PLAID_SECRET=test_secret
PLAID_ENVIRONMENT=sandbox
DEMO_PLAID_ACCESS_TOKEN=access-sandbox-test-12345

# Fraud Detection Rule Configuration
# Very lenient settings for testing scenarios
DETECTION_RULE_GEOGRAPHIC_DISTANCE_THRESHOLD_KM=1000
DETECTION_RULE_VELOCITY_TIME_WINDOW_SECONDS=60
DETECTION_RULE_VELOCITY_MAX_TRANSACTIONS=20

# Application Settings
LOGGING_LEVEL_ROOT=DEBUG
LOGGING_LEVEL_COM_BRAGDEV_FRAUD=TRACE

# Integration Services
# Using a placeholder for testing
SLACK_BOT_TOKEN=xoxb-placeholder-test-token