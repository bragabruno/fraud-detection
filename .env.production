# Production environment specific configurations - SECURE HANDLING REQUIRED

# Database Configuration
# Use PostgreSQL for production
SPRING_DATASOURCE_URL=jdbc:postgresql://db-host:5432/frauddb
SPRING_DATASOURCE_USERNAME=fraud_app_user
SPRING_DATASOURCE_PASSWORD=SECURE_PASSWORD_HERE
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false

# Plaid API Configuration
PLAID_CLIENT_ID=SECURE_PRODUCTION_CLIENT_ID
PLAID_SECRET=SECURE_PRODUCTION_SECRET
PLAID_ENVIRONMENT=production

# Fraud Detection Rule Configuration
# Stricter settings for production based on real-world fraud patterns
DETECTION_RULE_GEOGRAPHIC_DISTANCE_THRESHOLD_KM=50
DETECTION_RULE_VELOCITY_TIME_WINDOW_SECONDS=180
DETECTION_RULE_VELOCITY_MAX_TRANSACTIONS=3

# Application Settings
SERVER_PORT=8443
LOGGING_LEVEL_ROOT=WARN
LOGGING_LEVEL_COM_BRAGDEV_FRAUD=INFO

# Integration Services
# Use secure vault or environment variable injection in production
SLACK_BOT_TOKEN=SECURE_SLACK_TOKEN_FROM_VAULT

# IMPORTANT: In production, this file should never be committed to version control.
# Instead, use environment variables, Docker secrets, or a secure vault solution.