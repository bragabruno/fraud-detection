# Development environment specific configurations

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:h2:mem:frauddb
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=password
SPRING_H2_CONSOLE_ENABLED=true
SPRING_H2_CONSOLE_PATH=/h2-console
SPRING_JPA_SHOW_SQL=true

# Plaid API Configuration
PLAID_CLIENT_ID=development_client_id
PLAID_SECRET=development_secret
PLAID_ENVIRONMENT=sandbox
DEMO_PLAID_ACCESS_TOKEN=access-sandbox-12345

# Fraud Detection Rule Configuration
# More lenient settings for development and testing
DETECTION_RULE_GEOGRAPHIC_DISTANCE_THRESHOLD_KM=500
DETECTION_RULE_VELOCITY_TIME_WINDOW_SECONDS=600
DETECTION_RULE_VELOCITY_MAX_TRANSACTIONS=10

# Integration Services
# Using a placeholder for development
SLACK_BOT_TOKEN=xoxb-placeholder-development-token