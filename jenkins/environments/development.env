# Kubernetes Configuration
APP_NAMESPACE=fraud-detection-dev
KUBE_CLUSTER=dev-cluster
VAULT_ROLE=fraud-detection-dev

# Application Configuration
JAVA_OPTS="-Xms512m -Xmx1024m -Dspring.profiles.active=dev"
LOG_LEVEL=DEBUG

# Infrastructure (from Terraform outputs)
DB_HOST=${terraform output -raw rds_endpoint}
REDIS_HOST=${terraform output -raw redis_endpoint}
MONITORING_HOST=${terraform output -raw monitoring_endpoint}

# Docker Registry
DOCKER_REGISTRY=your-registry.com
DOCKER_REPO=fraud-detection

# Service Specific Configuration
API_GATEWAY_PORT=8080
TRANSACTION_SERVICE_PORT=8081
MONITORING_SERVICE_PORT=8082
NOTIFICATION_SERVICE_PORT=8083
RULE_ENGINE_PORT=8084
ANALYTICS_SERVICE_PORT=8085

# Resource Limits
CPU_REQUEST=500m
CPU_LIMIT=1000m
MEMORY_REQUEST=512Mi
MEMORY_LIMIT=1024Mi

# Monitoring
ENABLE_DETAILED_METRICS=true
PROMETHEUS_SCRAPE=true
TRACING_ENABLED=true

# Feature Flags
ENABLE_BETA_FEATURES=true
DEBUG_MODE=true