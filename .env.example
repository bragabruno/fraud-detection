# Fraud Detection System - Environment Variable Template
# IMPORTANT: Copy this file to .env, .env.development, .env.test, or .env.production
# and fill in the appropriate values for your environment.

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:h2:mem:frauddb                 # Development/Test
# SPRING_DATASOURCE_URL=jdbc:postgresql://db-host:5432/frauddb  # Production
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.h2.Driver         # Development/Test
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver    # Production
SPRING_DATASOURCE_USERNAME=<database_username>
SPRING_DATASOURCE_PASSWORD=<database_password>

# JPA/Hibernate Configuration
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.H2Dialect      # Development/Test
# SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect  # Production
SPRING_JPA_HIBERNATE_DDL_AUTO=update  # Options: create, update, validate, none
SPRING_JPA_SHOW_SQL=true              # Set to false in production

# Development-only Settings
SPRING_H2_CONSOLE_ENABLED=true        # H2 Console for development
SPRING_H2_CONSOLE_PATH=/h2-console    # Path for H2 Console

# Plaid API Configuration
PLAID_CLIENT_ID=<your_plaid_client_id>
PLAID_SECRET=<your_plaid_secret>
PLAID_ENVIRONMENT=sandbox             # Options: sandbox, development, production
PLAID_CLIENT_NAME=Fraud Detection System
PLAID_COUNTRY_CODES=US
PLAID_LANGUAGE=en
PLAID_REDIRECT_URI=http://localhost:8080/plaid/oauth
DEMO_PLAID_ACCESS_TOKEN=<demo_access_token>  # For development/testing only

# Fraud Detection Rule Configuration
DETECTION_RULE_GEOGRAPHIC_REFERENCE_LOCATION_LATITUDE=40.7128  # Example: New York City
DETECTION_RULE_GEOGRAPHIC_REFERENCE_LOCATION_LONGITUDE=-74.0060
DETECTION_RULE_GEOGRAPHIC_DISTANCE_THRESHOLD_KM=100
DETECTION_RULE_VELOCITY_TIME_WINDOW_SECONDS=300
DETECTION_RULE_VELOCITY_MAX_TRANSACTIONS=5

# Decision Manager Configuration
DECISION_RISK_THRESHOLD_LOW=20.0
DECISION_RISK_THRESHOLD_MEDIUM=50.0
DECISION_RISK_THRESHOLD_HIGH=80.0
DECISION_METHOD_WEIGHTS_RULE_ENGINE=0.5
DECISION_METHOD_WEIGHTS_STATISTICAL=0.2
DECISION_METHOD_WEIGHTS_MACHINE_LEARNING=0.2
DECISION_METHOD_WEIGHTS_NETWORK_ANALYSIS=0.1

# Application Settings
SPRING_APPLICATION_NAME=fraud-detection
SERVER_PORT=8080                      # Use 8443 for production with HTTPS
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_BRAGDEV_FRAUD=DEBUG

# Integration Services
SLACK_BOT_TOKEN=<your_slack_bot_token>  # Never commit actual tokens to version control

# Security Notice:
# - Never commit .env files with actual secrets to version control
# - In production, use environment variables, Docker secrets, or a secure vault solution
# - Rotate sensitive credentials regularly
# - Implement proper access controls for production secrets