# Example environment configuration - DO NOT STORE REAL CREDENTIALS HERE

# Database Configuration
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.h2.Driver
SPRING_DATASOURCE_URL=jdbc:h2:mem:exampledb
SPRING_DATASOURCE_USERNAME=example_user
SPRING_DATASOURCE_PASSWORD=example_password
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.H2Dialect
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true

# Plaid API Configuration
PLAID_CLIENT_NAME=Example Fraud Detection
PLAID_CLIENT_ID=example_client_id
PLAID_SECRET=example_secret
PLAID_ENVIRONMENT=sandbox
PLAID_COUNTRY_CODES=US
PLAID_LANGUAGE=en

# Fraud Detection Rule Configuration
DETECTION_RULE_GEOGRAPHIC_REFERENCE_LOCATION_LATITUDE=40.7128
DETECTION_RULE_GEOGRAPHIC_REFERENCE_LOCATION_LONGITUDE=-74.0060
DETECTION_RULE_GEOGRAPHIC_DISTANCE_THRESHOLD_KM=100

# Application Settings
SPRING_APPLICATION_NAME=fraud-detection
SERVER_PORT=8080
LOGGING_LEVEL_ROOT=INFO

# Integration Services
SLACK_BOT_TOKEN=xoxb-example-token