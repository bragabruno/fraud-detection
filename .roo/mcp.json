{
  "config": {
    "permissionsFile": "mcp-permissions.json",
    "commandTimeout": 300,
    "allowedCommands": "all",
    "allowedFlags": "all"
  },
  "mcpServers": {
    "mcp-installer": {
      "command": "npx",
      "args": [
        "-y",
        "@anaisbetts/mcp-installer"
      ],
      "alwaysAllow": [
        "install_repo_mcp_server",
        "install_local_mcp_server"
      ]
    },
    "mcp-obsidian": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-obsidian",
        "/Users/brunobraga/Library/Mobile Documents/iCloud~md~obsidian/Documents/Obsidian Vault"
      ],
      "alwaysAllow": [
        "read_notes",
        "search_notes"
      ]
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/brunobraga/"
      ],
      "alwaysAllow": [
        "read_file",
        "read_multiple_files",
        "write_file",
        "edit_file",
        "create_directory",
        "list_directory",
        "directory_tree",
        "move_file",
        "search_files",
        "get_file_info",
        "list_allowed_directories"
      ]
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "GITHUB_PERSONAL_ACCESS_TOKEN"
      },
      "alwaysAllow": [
        "create_or_update_file",
        "search_repositories",
        "create_repository",
        "get_file_contents",
        "push_files",
        "create_issue",
        "create_pull_request",
        "fork_repository",
        "create_branch",
        "list_commits",
        "list_issues",
        "update_issue",
        "add_issue_comment",
        "search_code",
        "search_issues",
        "search_users",
        "get_issue",
        "get_pull_request",
        "list_pull_requests",
        "create_pull_request_review",
        "merge_pull_request",
        "get_pull_request_files",
        "get_pull_request_status",
        "update_pull_request_branch",
        "get_pull_request_comments",
        "get_pull_request_reviews"
      ]
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://claude_user:T5+K+5iF3tTKLf6!op0ddXGaAmVS^tem@localhost:5432/claude_db"
      ],
      "alwaysAllow": [
        "query"
      ]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "alwaysAllow": [
        "sequentialthinking"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "alwaysAllow": [
        "create_entities",
        "create_relations",
        "add_observations",
        "delete_entities",
        "delete_observations",
        "search_nodes",
        "read_graph",
        "delete_relations",
        "open_nodes"
      ]
    },
    "git": {
      "command": "uvx",
      "args": [
        "mcp-server-git",
        "--repository",
        "/Users/brunobraga/Developer/dev/Vest-Social/vest-app",
        "--repository",
        "/Users/brunobraga/Developer/dev/Vest-Social/vest-backend-api",
        "--repository",
        "/Users/brunobraga/Developer/dev/Vest-Social/vest-cloud"
      ],
      "alwaysAllow": [
        "git_status",
        "git_diff_unstaged",
        "git_diff_staged",
        "git_diff",
        "git_commit",
        "git_log",
        "git_reset",
        "git_add",
        "git_create_branch",
        "git_show",
        "git_checkout"
      ]
    },
    "slack": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-slack"
      ],
      "env": {}
    },
    "brave-search": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-brave-search"
      ],
      "env": {
        "BRAVE_API_KEY": "BSAPTzlvw0sYrRZ-sf3nk2CjVjXrCXS"
      },
      "alwaysAllow": [
        "brave_web_search",
        "brave_local_search"
      ]
    },
    "exa": {
      "command": "npx",
      "args": [
        "-y",
        "exa-mcp-server"
      ],
      "env": {
        "EXA_API_KEY": "c3c0c1fb-2c65-49cd-95f7-5502925e4330"
      }
    },
    "@mcp-get-community-server-macos": {
      "command": "npx",
      "args": [
        "-y",
        "@mcp-get-community/server-macos",
        "/Users/brunobraga"
      ],
      "alwaysAllow": [
        "systemInfo",
        "sendNotification"
      ]
    },
    "mcp-transform-paths": {
      "command": "uvx",
      "args": [
        "@anthropic-ai/mcp-transform-paths",
        "--path",
        "/Users/brunobraga/Developer/dev/fraud-detection/app/src/main/java/com/bragdev/fraud-detection",
        "--replace-hyphen",
        "underscore"
      ]
    }
  }
}