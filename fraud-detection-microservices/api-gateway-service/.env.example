# SSL/TLS Configuration
SSL_KEYSTORE_PATH=/path/to/keystore.p12
SSL_KEYSTORE_PASSWORD=changeit
SSL_KEY_ALIAS=api-gateway
SSL_TRUSTSTORE_PATH=/path/to/truststore.p12
SSL_TRUSTSTORE_PASSWORD=changeit

# OAuth2 Configuration
OAUTH_CLIENT_ID=your-client-id
OAUTH_CLIENT_SECRET=your-client-secret
OAUTH_REDIRECT_URI=http://localhost:8080/login/oauth2/code/auth-server
OAUTH_ISSUER_URI=https://your-auth-server/

# JWT Configuration
JWT_HEADER=X-Auth-Token
JWT_SECRET=your-jwt-signing-key

# Service Discovery
EUREKA_SERVER_URL=http://localhost:8761/eureka